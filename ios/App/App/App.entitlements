<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode switches this to "production" when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links; change the host if the production domain differs (see mobile/README.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.refinerylens.ng</string>
	</array>
</dict>
</plist>
