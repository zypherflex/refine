# --- Required ---
# PostgreSQL connection string
DATABASE_URL="postgresql://refinerylens:refinerylens@localhost:5432/refinerylens"
# Long random string used to sign session tokens (generate: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app (used for origin checks and links)
APP_URL="http://localhost:3000"

# --- Document storage ---
# "local" stores files in STORAGE_DIR (outside the public web root). "s3" (AWS S3, R2, MinIO…) requires the S3_* values.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="15"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""   # optional, for S3-compatible providers

# --- AI research assistant (optional) ---
# Without a key the assistant runs in "evidence mode": retrieval + extractive, cited answers, no language model.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"

# --- Notifications (optional) ---
# In-app alerts always work. Email delivery is only claimed when a provider is configured.
# Email copies of alerts are sent by the worker (`npm run worker`) to users who opt in.
# EMAIL_PROVIDER="smtp"
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# EMAIL_FROM="RefineryLens <alerts@example.com>"

# --- Payments (optional) ---
# Payment collection stays disabled until a provider is configured.
# Card payments for the Pro plan through Paystack. Set the webhook URL in the Paystack dashboard to
# {APP_URL}/api/payments/paystack/webhook. The plan changes only after Paystack verifies the charge.
# PAYMENT_PROVIDER="paystack"
# PAYSTACK_SECRET_KEY="sk_live_..."
# PRO_PLAN_PRICE_NGN="25000"

# --- Text alerts and morning price digest (optional) ---
# One provider: "termii", "africastalking" or "whatsapp". Texts go only to users who add a phone and opt in.
# TEXT_PROVIDER="termii"
# TERMII_API_KEY=""
# TERMII_SENDER_ID=""          # an approved sender ID
# TERMII_BASE_URL="https://api.ng.termii.com"   # use the base URL shown in your Termii dashboard
# TERMII_CHANNEL="generic"     # or "dnd" for numbers on Do-Not-Disturb
# AT_USERNAME="sandbox"        # Africa's Talking app username ("sandbox" uses the sandbox API)
# AT_API_KEY=""
# AT_SENDER_ID=""
# WHATSAPP_TOKEN=""            # WhatsApp Cloud API system-user token
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE=""         # an approved template with one body parameter for the message text
# WHATSAPP_TEMPLATE_LANG="en"
# WHATSAPP_API_VERSION="v23.0"

# --- USSD price check (optional) ---
# Africa's Talking USSD callback: {APP_URL}/api/ussd?token={USSD_TOKEN}. Use a long random token.
# USSD_TOKEN=""

# --- Company registry lookup for verification (optional) ---
# CAC lookup through Dojah; results are shown to the administrator who verifies a business.
# CAC_LOOKUP_PROVIDER="dojah"
# DOJAH_APP_ID=""
# DOJAH_SECRET_KEY=""
# DOJAH_BASE_URL="https://api.dojah.io"   # https://sandbox.dojah.io for testing

# --- Gas site geocoding (optional) ---
# Approximate coordinates for gas sites through OpenStreetMap Nominatim, one lookup a second in the worker.
# For heavy use, point NOMINATIM_URL at your own or a paid instance.
# GEOCODER="nominatim"
# NOMINATIM_EMAIL="ops@example.com"
# NOMINATIM_URL="https://nominatim.openstreetmap.org"

# --- Open data feeds (optional) ---
# Free public APIs for market, macro and refinery-directory context. Values are cached in PostgreSQL and refreshed
# by the worker; pages never call these APIs directly. New sources start unapproved: an editor approves each one
# (Editorial desk > Sources) before readers see its data.
# Feeds that need no key (World Bank, ExchangeRate-API, Climate TRACE, GDELT) are on by default. List a subset to
# restrict them, or set "none" to turn all feeds off: eia, worldbank, exchangerate-api, climate-trace, gdelt
# OPEN_DATA_FEEDS=""
# Free key from https://www.eia.gov/opendata/register.php, for oil and product spot prices, US refinery utilization
# and Nigerian crude production. Without it the EIA feed stays off and the UI says so.
# EIA_API_KEY=""
# How often the worker refreshes feeds (hours, default 12; 0 disables scheduled refreshes).
# OPEN_DATA_INTERVAL_HOURS="12"
# Emissions year requested from Climate TRACE (default: two years before the current year).
# CLIMATE_TRACE_YEAR=""

# --- Background jobs ---
# Uploads are queued in PostgreSQL. By default the web process also drains the queue right after an upload.
# Set to "false" in production and run `npm run worker` as a separate process.
# INLINE_JOBS="true"
