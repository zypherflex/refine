// RefineryLens data model.
// Provenance, review status and correction history are first-class so every figure can be traced.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ANALYST
  EDITOR
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(TEAM)
  createdAt DateTime @default(now())
  members   User[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           Role          @default(USER)
  plan           Plan          @default(FREE)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // Opt-in to email copies of alerts. Only offered when an email provider is configured.
  emailAlerts    Boolean       @default(false)
  createdAt      DateTime      @default(now())

  sessions      Session[]
  theses        Thesis[]
  documents     Document[]        @relation("DocumentOwner")
  watchlists    Watchlist[]
  alerts        Alert[]
  conversations Conversation[]
  reviews       EditorialReview[]
  auditLogs     AuditLog[]
  hubBusiness   HubBusiness?
  hubThreads    HubThread[]       @relation("HubThreadStarter")
  hubMessages   HubMessage[]
  hubReports    HubReport[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum CoverageStatus {
  ACTIVE
  IN_PREPARATION
  DEMONSTRATION
}

model Company {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  shortName      String
  country        String
  sector         String
  description    String
  coverageStatus CoverageStatus @default(IN_PREPARATION)
  coverageNote   String         @default("")
  isFictional    Boolean        @default(false)
  // Company-stated facts shown on the profile with their source, e.g. [{label, value, sourceUrl, retrievedAt}]
  profileFacts   Json?
  createdAt      DateTime       @default(now())

  legalEntities LegalEntity[]
  documents     Document[]
  announcements Announcement[]
  metrics       Metric[]
  risks         Risk[]
  theses        Thesis[]
  watchlists    Watchlist[]
  conflicts     SourceConflict[]
}

enum EntityScope {
  GROUP
  REFINERY
  SUBSIDIARY
  NATIONAL_SECTOR
}

model LegalEntity {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  scope     EntityScope
  notes     String      @default("")

  announcements Announcement[]
  metrics       Metric[]
}

// Who published something. Labels describe provenance, not accuracy.
enum Provenance {
  COMPANY_DISCLOSED
  REGULATOR_EXCHANGE
  INDEPENDENT_REPORT
  ANALYST_ESTIMATE
  USER_ASSUMPTION
  UNVERIFIED
}

model Source {
  id           String     @id @default(cuid())
  name         String
  publisher    String
  homepageUrl  String     @default("")
  provenance   Provenance
  approved     Boolean    @default(false)
  approvedById String?
  approvedAt   DateTime?
  licenseNotes String     @default("")
  isFictional  Boolean    @default(false)
  createdAt    DateTime   @default(now())

  documents     Document[]
  announcements Announcement[]
}

enum DocumentType {
  ANNUAL_REPORT
  INTERIM_REPORT
  PRESS_RELEASE
  EXCHANGE_FILING
  REGULATORY_PUBLICATION
  NEWS_REPORT
  ANALYST_NOTE
  PRESENTATION
  OTHER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  APPROVED
  FAILED
  RETRACTED
}

model Document {
  id             String         @id @default(cuid())
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  sourceId       String?
  source         Source?        @relation(fields: [sourceId], references: [id])
  title          String
  publisher      String         @default("")
  url            String         @default("")
  documentType   DocumentType   @default(OTHER)
  version        String         @default("1")
  publishedAt    DateTime?
  eventDate      DateTime?
  retrievedAt    DateTime       @default(now())
  provenance     Provenance     @default(UNVERIFIED)
  visibility     Visibility     @default(PUBLIC)
  ownerId        String?
  owner          User?          @relation("DocumentOwner", fields: [ownerId], references: [id])
  storageKey     String?
  originalName   String         @default("")
  mimeType       String         @default("")
  sizeBytes      Int            @default(0)
  sha256         String         @default("")
  pageCount      Int            @default(0)
  status         DocumentStatus @default(UPLOADED)
  processingNote String         @default("")
  topics         String[]       @default([])
  isFictional    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pages     DocumentPage[]
  metrics   Metric[]
  excerpts  Excerpt[]
  citations Citation[]
  reviews   EditorialReview[]

  @@index([visibility, ownerId])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  text       String

  @@unique([documentId, pageNumber])
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETRACTED
  SUPERSEDED
}

model Announcement {
  id                      String            @id @default(cuid())
  companyId               String
  company                 Company           @relation(fields: [companyId], references: [id])
  legalEntityId           String?
  legalEntity             LegalEntity?      @relation(fields: [legalEntityId], references: [id])
  sourceId                String?
  source                  Source?           @relation(fields: [sourceId], references: [id])
  headline                String
  originalTitle           String
  publisher               String
  sourceUrl               String
  documentType            DocumentType
  sourceVersion           String            @default("1")
  eventDate               DateTime?
  sourcePublishedAt       DateTime
  retrievedAt             DateTime
  provenance              Provenance
  summary                 String
  whatChanged             String            @default("")
  whyItMatters            String
  uncertainties           String
  analysis                String            @default("")
  alternativeExplanations String            @default("")
  openQuestions           String            @default("")
  topics                  String[]          @default([])
  status                  PublicationStatus @default(DRAFT)
  aiGenerated             Boolean           @default(false)
  reviewerId              String?
  reviewedAt              DateTime?
  publishedAt             DateTime?
  retractedAt             DateTime?
  retractionReason        String            @default("")
  revision                Int               @default(1)
  supersedesId            String?           @unique
  supersedes              Announcement?     @relation("Supersession", fields: [supersedesId], references: [id])
  supersededBy            Announcement?     @relation("Supersession")
  duplicateOfId           String?
  isFictional             Boolean           @default(false)
  createdById             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  excerpts       Excerpt[]
  corrections    Correction[]
  reviews        EditorialReview[]
  thesisEvidence ThesisEvidence[]
  citations      Citation[]
  conflictClaims ConflictClaim[]
  riskEvidence   RiskEvidence[]

  @@index([companyId, status])
}

model Excerpt {
  id             String        @id @default(cuid())
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id])
  page           Int?
  quote          String
}

enum MetricCategory {
  FINANCIAL
  OPERATIONAL
}

enum AuditStatus {
  AUDITED
  UNAUDITED
  RESTATED
  NOT_APPLICABLE
}

enum ValueType {
  REPORTED
  CALCULATED
  ESTIMATED
}

enum DisclosureStatus {
  DISCLOSED
  NOT_DISCLOSED
}

model Metric {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  legalEntityId    String?
  legalEntity      LegalEntity?      @relation(fields: [legalEntityId], references: [id])
  key              String
  category         MetricCategory
  label            String
  value            Decimal?          @db.Decimal(24, 6)
  unit             String
  currency         String?
  scale            String            @default("units")
  periodStart      DateTime?
  periodEnd        DateTime?
  periodLabel      String
  periodType       String
  scope            EntityScope
  auditStatus      AuditStatus       @default(NOT_APPLICABLE)
  valueType        ValueType         @default(REPORTED)
  disclosureStatus DisclosureStatus  @default(DISCLOSED)
  provenance       Provenance
  formula          String            @default("")
  inputs           Json?
  methodology      String            @default("")
  documentId       String?
  document         Document?         @relation(fields: [documentId], references: [id])
  page             Int?
  excerpt          String            @default("")
  status           PublicationStatus @default(DRAFT)
  notes            String            @default("")
  isFictional      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  corrections    Correction[]
  conflictClaims ConflictClaim[]
  citations      Citation[]

  @@index([companyId, key, status])
}

model SourceConflict {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  topic       String
  description String
  // DRAFT (flagged, not yet public) | UNRESOLVED (public, difference open) | RESOLVED
  status      String          @default("UNRESOLVED")
  resolution  String          @default("")
  flaggedById String?
  createdAt   DateTime        @default(now())
  claims      ConflictClaim[]
}

model ConflictClaim {
  id             String         @id @default(cuid())
  conflictId     String
  conflict       SourceConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  claim          String
  sourceLabel    String
  sourceDate     DateTime
  provenance     Provenance
  announcementId String?
  announcement   Announcement?  @relation(fields: [announcementId], references: [id])
  metricId       String?
  metric         Metric?        @relation(fields: [metricId], references: [id])
}

model Correction {
  id             String        @id @default(cuid())
  entityType     String
  entityId       String
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  metricId       String?
  metric         Metric?       @relation(fields: [metricId], references: [id])
  kind           String        @default("CORRECTION") // CORRECTION | RETRACTION | SUPERSESSION | EXTRACTION_FIX
  summary        String
  before         Json?
  after          Json?
  createdById    String
  createdAt      DateTime      @default(now())
}

model EditorialReview {
  id             String        @id @default(cuid())
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id])
  reviewerId     String
  reviewer       User          @relation(fields: [reviewerId], references: [id])
  decision       String // APPROVE | REQUEST_CHANGES | REJECT
  notes          String        @default("")
  createdAt      DateTime      @default(now())
}

enum RiskCategory {
  CRUDE_SUPPLY
  PRICES_AND_MARGINS
  FOREIGN_EXCHANGE
  DEBT_AND_LIQUIDITY
  OPERATIONAL_RELIABILITY
  REGULATION_AND_TAX
  COMPETITION
  EXPANSION_EXECUTION
  GOVERNANCE
  ENVIRONMENT_AND_COMMUNITY
}

enum Level {
  LOW
  MODERATE
  HIGH
}

model Risk {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  category             RiskCategory
  title                String
  summary              String
  evidenceSummary      String
  impactPathway        String
  horizon              String
  severity             Level
  confidence           Level
  evidenceQuality      String
  uncertainty          String
  clarifyingDisclosure String
  status               PublicationStatus @default(DRAFT)
  isFictional          Boolean           @default(false)
  updatedAt            DateTime          @updatedAt
  createdAt            DateTime          @default(now())
  evidence             RiskEvidence[]
}

model RiskEvidence {
  id             String        @id @default(cuid())
  riskId         String
  risk           Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  note           String        @default("")
}

model Thesis {
  id                     String    @id @default(cuid())
  ownerId                String
  owner                  User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  title                  String
  rationale              String
  reassessmentConditions String    @default("")
  reviewDate             DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  assumptions Assumption[]
  indicators  ThesisIndicator[]
  evidence    ThesisEvidence[]
  versions    ThesisVersion[]

  @@index([ownerId])
}

model Assumption {
  id        String           @id @default(cuid())
  thesisId  String
  thesis    Thesis           @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  statement String
  topics    String[]         @default([])
  position  Int              @default(0)
  evidence  ThesisEvidence[]
}

model ThesisIndicator {
  id        String   @id @default(cuid())
  thesisId  String
  thesis    Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  metricKey String
  label     String
  operator  String   @default("BELOW") // BELOW | ABOVE
  threshold Decimal? @db.Decimal(24, 6)
  unit      String   @default("")
}

model ThesisEvidence {
  id                      String        @id @default(cuid())
  thesisId                String
  thesis                  Thesis        @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  assumptionId            String?
  assumption              Assumption?   @relation(fields: [assumptionId], references: [id], onDelete: SetNull)
  announcementId          String?
  announcement            Announcement? @relation(fields: [announcementId], references: [id])
  stance                  String        @default("UNCLEAR") // SUPPORTS | CHALLENGES | UNCLEAR
  note                    String        @default("")
  origin                  String        @default("USER") // USER | SUGGESTED
  status                  String        @default("ACCEPTED") // PENDING_REVIEW | ACCEPTED | DISMISSED
  matchReason             String        @default("")
  alternativeExplanations String        @default("")
  questions               String        @default("")
  createdAt               DateTime      @default(now())

  @@unique([thesisId, assumptionId, announcementId])
}

model ThesisVersion {
  id        String   @id @default(cuid())
  thesisId  String
  thesis    Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([thesisId, version])
}

enum AlertFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}

model Watchlist {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  topics    String[]       @default([])
  frequency AlertFrequency @default(IMMEDIATE)
  createdAt DateTime       @default(now())

  @@unique([userId, companyId])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // NEW_ANNOUNCEMENT | CORRECTION | RETRACTION | SUPERSESSION | THESIS_MATCH
  title     String
  body      String
  link      String
  dedupeKey String
  channel   String    @default("IN_APP")
  // Alerts for daily/weekly subscribers become visible at the next digest time.
  visibleAt DateTime  @default(now())
  readAt    DateTime?
  // Set once an email copy has been sent (or deliberately skipped when the user opted in later).
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([emailedAt, visibleAt])
  @@index([userId, readAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  title     String
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  structured     Json?
  mode           String       @default("")
  createdAt      DateTime     @default(now())
  citations      Citation[]
}

model Citation {
  id             String        @id @default(cuid())
  messageId      String
  message        Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ref            String // e.g. "S1"
  kind           String // DOCUMENT_PAGE | ANNOUNCEMENT | METRIC | THESIS
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id])
  page           Int?
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  metricId       String?
  metric         Metric?       @relation(fields: [metricId], references: [id])
  label          String
  quote          String        @default("")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  error       String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}

enum HubRole {
  SELLER
  BUYER
  DELIVERY
  REFINERY
}

enum HubVerification {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  SUSPENDED
}

// One trading profile per user. Anyone can post straight away; an administrator checks the registration and
// licence details before the business is marked verified.
model HubBusiness {
  id                 String          @id @default(cuid())
  ownerId            String          @unique
  owner              User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  roles              HubRole[]
  about              String          @default("")
  state              String
  city               String          @default("")
  website            String          @default("")
  // CAC registration number and licences (e.g. NMDPRA) the business says it holds. Checked on verification.
  registrationNumber String          @default("")
  licences           String          @default("")
  // Refineries only: nameplate capacity the business states, in barrels per day.
  capacityBpd        Int?
  verification       HubVerification @default(UNVERIFIED)
  // Shown to the owner: why a verification request was returned or the business suspended.
  verificationNote   String          @default("")
  verifiedAt         DateTime?
  verifiedById       String?
  // Seeded demo businesses are labelled so nobody mistakes them for real trading partners.
  isDemo             Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  listings         HubListing[]
  threads          HubThread[]
  reports          HubReport[]
  priceReports     PriceReport[]
  jobsPosted       DeliveryJob[]     @relation("JobPoster")
  quotes           DeliveryQuote[]
  buyerAgreements  SupplyAgreement[] @relation("AgreementBuyer")
  sellerAgreements SupplyAgreement[] @relation("AgreementSeller")

  @@index([verification])
}

enum HubListingKind {
  OFFER
  REQUEST
  DELIVERY
}

enum HubListingStatus {
  ACTIVE
  CLOSED
}

model HubListing {
  id         String           @id @default(cuid())
  businessId String
  business   HubBusiness      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       HubListingKind
  title      String
  details    String           @default("")
  products   String[]
  quantity   Float?
  unit       String           @default("")
  // Free text such as "NGN 1,050 per litre ex-depot, valid this week". Prices move fast, so nothing is computed.
  priceNote  String           @default("")
  // Where the goods are, the buyer is, or the fleet is based.
  state      String
  // States a seller or haulier serves, or a buyer will accept delivery from.
  areas      String[]         @default([])
  status     HubListingStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  threads HubThread[]

  @@index([kind, status, expiresAt])
  @@index([businessId])
}

// A private conversation between the user who made an enquiry and the business it was sent to. Only those two
// people can read it; administrators cannot.
model HubThread {
  id            String      @id @default(cuid())
  businessId    String
  business      HubBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       HubListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  starterId     String
  starter       User        @relation("HubThreadStarter", fields: [starterId], references: [id], onDelete: Cascade)
  subject       String
  lastMessageAt DateTime    @default(now())
  starterReadAt DateTime    @default(now())
  ownerReadAt   DateTime?
  createdAt     DateTime    @default(now())

  messages HubMessage[]

  @@unique([starterId, businessId, listingId])
  @@index([starterId, lastMessageAt])
  @@index([businessId, lastMessageAt])
}

model HubMessage {
  id        String    @id @default(cuid())
  threadId  String
  thread    HubThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
}

enum HubReportStatus {
  OPEN
  CLOSED
}

model HubReport {
  id         String          @id @default(cuid())
  businessId String
  business   HubBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     HubReportStatus @default(OPEN)
  createdAt  DateTime        @default(now())

  @@index([status])
}

model PriceReport {
  id         String      @id @default(cuid())
  businessId String
  business   HubBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // An entry from PRICE_ITEMS, e.g. lpg_retail_kg or ago_depot_litre.
  item       String
  state      String
  priceNaira Float
  // The day the price applied, at midnight UTC. One report per business, item, state and day.
  day        DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([businessId, item, state, day])
  @@index([item, day])
}

// ---------------------------------------------------------------------------------------------------------------
// Delivery jobs: a business posts a load, delivery partners quote, the poster accepts one, and both sides confirm
// the delivery. RefineryLens records the agreement; payment is settled between the businesses.

enum DeliveryJobStatus {
  OPEN
  AWARDED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model DeliveryJob {
  id                 String            @id @default(cuid())
  posterId           String
  poster             HubBusiness       @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  title              String
  products           String[]
  quantity           Float
  unit               String
  fromState          String
  fromTown           String            @default("")
  toState            String
  toTown             String            @default("")
  pickupDate         DateTime
  details            String            @default("")
  status             DeliveryJobStatus @default(OPEN)
  acceptedQuoteId    String?           @unique
  posterConfirmedAt  DateTime?
  carrierConfirmedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  quotes DeliveryQuote[]

  @@index([status, pickupDate])
}

model DeliveryQuote {
  id         String      @id @default(cuid())
  jobId      String
  job        DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  carrierId  String
  carrier    HubBusiness @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  priceNaira Float
  note       String      @default("")
  status     QuoteStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([jobId, carrierId])
}

// ---------------------------------------------------------------------------------------------------------------
// Recurring supply agreements: a buyer and a seller record a standing arrangement, the seller logs each delivery and
// the buyer confirms or disputes it. Confirmed deliveries build each seller's public reliability record.

enum AgreementFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum AgreementStatus {
  PROPOSED
  ACTIVE
  PAUSED
  ENDED
  DECLINED
}

enum SupplyDeliveryStatus {
  LOGGED
  CONFIRMED
  DISPUTED
}

model SupplyAgreement {
  id           String             @id @default(cuid())
  buyerId      String
  buyer        HubBusiness        @relation("AgreementBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       HubBusiness        @relation("AgreementSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  // Which side proposed; the other side accepts or declines.
  proposedById String
  product      String
  quantity     Float
  unit         String
  frequency    AgreementFrequency
  deliverTo    String
  priceNote    String             @default("")
  notes        String             @default("")
  startDate    DateTime
  endDate      DateTime?
  status       AgreementStatus    @default(PROPOSED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  deliveries SupplyDelivery[]

  @@index([buyerId])
  @@index([sellerId])
}

model SupplyDelivery {
  id          String               @id @default(cuid())
  agreementId String
  agreement   SupplyAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  deliveredOn DateTime
  quantity    Float
  status      SupplyDeliveryStatus @default(LOGGED)
  buyerNote   String               @default("")
  confirmedAt DateTime?
  createdAt   DateTime             @default(now())

  @@unique([agreementId, deliveredOn])
}
